# Copy this file to ".env" and fill it in. Never share the token.

# Bot token from the Discord Developer Portal (Bot tab). Yours alone.
DISCORD_TOKEN=

# Discord user IDs allowed to use the admin module, comma-separated.
# (Developer Mode on -> right-click your name -> Copy User ID.)
# Leave empty and the admin module stays disabled.
ADMIN_USER_IDS=

# Optional: channel ID where every admin proposal + outcome is logged.
AUDIT_CHANNEL_ID=

# Minecraft server address for the !mc status module.
MC_ADDRESS=localhost:25565

# Optional: watch module HTTP checks as Name=URL pairs, comma-separated.
# Leave empty for the defaults (built from the MC_ADDRESS host):
# Dashboard :8124, Jellyfin :8096/health.
WATCH_URLS=

# Optional: Minecraft backups folder inside the container (compose
# mounts the host folder read-only at this path). If the newest backup
# is more than 26 hours old, the watch module alerts.
WATCH_BACKUP_DIR=/backups

# Optional: Spotify API credentials - only needed for playlist/album
# links in !play (single tracks work without). Free at
# developer.spotify.com/dashboard - create an app, copy both values.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

COMMAND_PREFIX=!

# Optional: starboard map file. Default in Docker is /data/starboard.json
# (on the bot-data volume in docker-compose.yml) - leave empty normally.
STARBOARD_DATA_FILE=

# Optional: game-updates tracker state file. Default in Docker is
# /data/updates-state.json (same bot-data volume) - leave empty normally.
UPDATES_DATA_FILE=
