# Copy this file to ".env" and fill it in. Never share the token.

# Bot token from the Discord Developer Portal (Bot tab). Yours alone.
DISCORD_TOKEN=

# Discord user IDs allowed to use the admin module, comma-separated.
# (Developer Mode on -> right-click your name -> Copy User ID.)
# Leave empty and the admin module stays disabled.
ADMIN_USER_IDS=

# Optional: channel ID where every admin proposal + outcome is logged.
AUDIT_CHANNEL_ID=

# Minecraft server address for the !mc status module.
MC_ADDRESS=localhost:25565

# Optional: Spotify API credentials - only needed for playlist/album
# links in !play (single tracks work without). Free at
# developer.spotify.com/dashboard - create an app, copy both values.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

COMMAND_PREFIX=!
